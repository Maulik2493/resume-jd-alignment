# Resume ↔ JD Alignment Engine — Environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — secrets never get committed.

# ── Secrets (required) ──────────────────────────────────────────────────────
OPENAI_API_KEY=your-api-key-here

# ── LLM settings (optional — sensible defaults in app/config.py) ────────────
# OPENAI_BASE_URL=          # Custom endpoint for Azure OpenAI or proxies
# OPENAI_MODEL=gpt-4o-mini  # Model identifier
# OPENAI_TEMPERATURE=0      # Must be 0 or near-0 per design principles
# OPENAI_MAX_RETRIES=1      # Retry count on validation failure
