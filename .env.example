# Resume ↔ JD Alignment Engine — Environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored — secrets never get committed.

# ── LLM Provider ────────────────────────────────────────────────────────────
# Default: local Ollama. Override all three for OpenAI / Azure OpenAI.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.2

# ── For OpenAI (uncomment and fill in) ──────────────────────────────────────
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── LLM settings (optional — sensible defaults in app/config.py) ────────────
# OPENAI_TEMPERATURE=0      # Must be 0 or near-0 per design principles
# OPENAI_MAX_RETRIES=1      # Retry count on validation failure
